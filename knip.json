{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["lint-staged"],
  "workspaces": {
    "apps/dm-tool": {
      "entry": ["electron/main.ts", "electron/preload.ts", "electron.vite.config.ts"],
      "project": ["electron/**/*.ts", "src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss", "tailwindcss-animate"]
    },
    "apps/player-portal": {
      "vite": false
    },
    "packages/ai": {
      "entry": [
        "src/index.ts",
        "src/chat/index.ts",
        "src/classifier/index.ts",
        "src/hooks/index.ts",
        "src/loot/index.ts",
        "harness/run.ts"
      ],
      "project": ["src/**/*.ts", "harness/**/*.ts"]
    }
  }
}
