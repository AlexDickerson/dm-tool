{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "detail": "electron-vite dev — Electron window with hot reload",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dmtool", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "build",
      "detail": "Full production build (main + preload + renderer)",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "typecheck",
      "detail": "tsc --noEmit for both node + web tsconfigs",
      "type": "shell",
      "command": "npm run typecheck",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "npm run lint",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "test",
      "detail": "vitest run (single pass)",
      "type": "shell",
      "command": "npm run test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
